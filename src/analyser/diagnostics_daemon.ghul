namespace Analyser is
    use System.Exception;
    use System.Text.UTF8Encoding;

    use System.Net.Sockets.AddressFamily;
    use System.Net.Sockets.NetworkStream;
    use System.Net.Sockets.ProtocolType;
    use System.Net.Sockets.SelectMode;
    use System.Net.Sockets.Socket;
    use System.Net.Sockets.SocketType;
    use System.Net.Sockets.UnixDomainSocketEndPoint;

    use Analysis.Protocol.DIAGNOSTIC;

    use IO.File;
    use IO.Path;
    use IO.StreamReader;
    use IO.StreamWriter;
    use IO.Std;

    // A tiny Unix-domain-socket front end onto an ANALYSER_POOL, standing in
    // for the MCP stdio transport when the caller is a shell script (a
    // Claude Code hook) rather than an MCP client. One request per
    // connection: two lines in (project directory, file path relative to
    // it), then one line per diagnostic on that file, then a blank line and
    // the connection closes. Kept deliberately dumber than the MCP wire
    // protocol - no JSON, no batching - because its only job is routing a
    // "diagnose this file" request to a session the pool is already keeping
    // warm, so a hook firing on every edit doesn't pay a cold analyser spawn
    // each time.
    class DIAGNOSTICS_DAEMON is
        // Bound on how long a connection may sit idle mid-request. The
        // accept loop is single-threaded, so a client that connects and
        // never finishes writing its two header lines (a stalled or buggy
        // hook invocation) would otherwise stall every other caller behind
        // it indefinitely.
        SOCKET_TIMEOUT_MS: int static => 10000;

        // How long the daemon waits for a connection before giving up and
        // exiting. It holds a pool of warm analysers, so an editing session
        // that ended hours ago otherwise costs hundreds of megabytes to
        // answer nothing - the same trade the analyser's own idle timeout
        // makes, and the same default. The spawning hook relaunches on
        // demand, so the only cost of exiting early is one cold pool.
        DEFAULT_IDLE_TIMEOUT_SECONDS: int static => 1800;

        // Granularity of the wait. The accept loop cannot block indefinitely
        // and still notice the timeout, so it polls in chunks; the wakeups
        // are far too cheap to register against the process's CPU time.
        POLL_CHUNK_SECONDS: int static => 5;

        run(socket_path: string, pool: ANALYSER_POOL, idle_timeout_seconds: int) static is
            if File.exists(socket_path) then
                File.delete(socket_path);
            fi

            let listener = Socket(AddressFamily.UNIX, SocketType.STREAM, ProtocolType.UNSPECIFIED);

            listener.bind(UnixDomainSocketEndPoint(socket_path));
            listener.listen(16);

            Std.error.write_line("ghul-mcp: diagnostics daemon listening on {socket_path}");

            // A disabled timeout waits indefinitely, which is what Poll does
            // with a negative timeout.
            let poll_microseconds =
                if idle_timeout_seconds <= 0 then
                    -1
                else
                    POLL_CHUNK_SECONDS * 1000000
                fi;

            try
                let idle_seconds mut = 0;

                do
                    if !listener.poll(poll_microseconds, SelectMode.SELECT_READ) then
                        idle_seconds = idle_seconds + POLL_CHUNK_SECONDS;

                        if idle_timeout_seconds > 0 /\ idle_seconds >= idle_timeout_seconds then
                            Std.error.write_line(
                                "ghul-mcp: diagnostics daemon exiting after {idle_timeout_seconds}s idle"
                            );

                            break;
                        fi

                        continue;
                    fi

                    idle_seconds = 0;

                    let client = listener.accept();

                    try
                        handle_connection(client, pool);
                    catch ex: Exception
                        Std.error.write_line("ghul-mcp: diagnostics daemon connection error: {ex.message}");
                    finally
                        client.close();
                    yrt
                od
            finally
                listener.close();

                try
                    File.delete(socket_path);
                catch ex: Exception
                yrt
            yrt
        si

        handle_connection(client: Socket, pool: ANALYSER_POOL) static is
            client.receive_timeout = SOCKET_TIMEOUT_MS;
            client.send_timeout = SOCKET_TIMEOUT_MS;

            let stream = NetworkStream(client, false);
            let encoding = UTF8Encoding(false);

            let reader = StreamReader(stream, encoding);
            let writer = StreamWriter(stream, encoding);

            writer.auto_flush = true;

            let project = reader.read_line();
            let path = reader.read_line();

            if !project? \/ !path? \/ path.length == 0 then
                writer.write_line("ERROR\tmissing project or path");
                writer.write_line("");
                return;
            fi

            if !is_within_project(project, path) then
                writer.write_line("ERROR\tpath escapes the project directory");
                writer.write_line("");
                return;
            fi

            try
                let session = pool.get_session(project);
                let response = session.edit_diagnostics(path);

                for diagnostic in response.diagnostics do
                    if diagnostic.path =~ path then
                        let message = diagnostic.message.replace('\n', ' ').replace('\r', ' ').replace('\t', ' ');

                        writer.write_line(
                            "{diagnostic.severity}\t{diagnostic.start_line}\t{diagnostic.start_column}"
                            "\t{diagnostic.code}\t{message}"
                        );
                    fi
                od
            catch ex: Exception
                writer.write_line("ERROR\t{ex.message.replace('\n', ' ')}");
            yrt

            writer.write_line("");
        si

        // Rejects an absolute `path` (Path.combine ignores the base and
        // returns it as-is) and a `../` escape, either of which would
        // otherwise let any local caller on this socket read and EDIT an
        // arbitrary file outside the project - this front end has no other
        // access control, unlike the MCP tools, which are only reachable
        // over the spawning process's own stdio.
        is_within_project(project_directory: string, path: string) -> bool static is
            let root = Path.get_full_path(project_directory);
            let resolved = Path.get_full_path(Path.combine(root, path));

            let root_with_separator =
                if root.ends_with(Path.directory_separator_char) then
                    root
                else
                    "{root}{Path.directory_separator_char}"
                fi;

            return resolved.starts_with(root_with_separator);
        si
    si
si
